{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "model": "opusplan",
  "fallbackModel": ["opus", "fable"],
  "alwaysThinkingEnabled": true,
  "effortLevel": "high",
  "permissions": {
    "allow": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "mcp__github__create_pull_request"
    ],
    "ask": [
      "Bash(git merge:*)",
      "Bash(gh pr merge:*)",
      "mcp__github__merge_pull_request"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [{ "type": "command", "command": "bash .claude/report-status.sh" }]
      }
    ]
  }
}
