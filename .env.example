# ── AI hội thoại (chat/viết/nói) — api/claude.ts ────────────────────────────
# Ưu tiên: Gemini (FREE quota) → Groq Llama (FREE) → Anthropic Claude (paid, high quality)
# Chỉ cần ÍT NHẤT MỘT key trong ba: GEMINI_API_KEY, GROQ_API_KEY, ANTHROPIC_API_KEY
#
# QUAN TRỌNG: không có tiền tố VITE_ — key chỉ được đọc ở phía server
# (vite.config.ts lúc "npm run dev", api/claude.ts lúc chạy server.ts trên VPS).

# Google Gemini — lấy key tại https://ai.google.dev/gemini-api/docs/api-key (FREE quota, khuyên dùng)
GEMINI_API_KEY=AIza...
# (Tùy chọn) đổi model Gemini, mặc định gemini-2.0-flash (nhanh & rẻ)
# GEMINI_MODEL=gemini-2.0-flash

# Groq (Llama, FREE) — lấy key tại https://console.groq.com/keys
GROQ_API_KEY=gsk_...
# (Tùy chọn) đổi model chat của Groq, mặc định llama-3.3-70b-versatile
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Anthropic Claude — lấy key tại https://console.anthropic.com/ (cần credit)
ANTHROPIC_API_KEY=sk-ant-...

# Dự án deploy bằng VPS (Express server.ts + PM2 + Nginx) — KHÔNG dùng Vercel.
# Khi deploy lên VPS (xem docs/deploy-vps-ubuntu.md): dán toàn bộ các biến
# trong file này vào file `.env` trên VPS (cùng thư mục với server.ts).

# ── Tên miền site (cho thẻ canonical SEO trong App.tsx) ─────────────────────
# Bỏ trống = dùng mặc định domain production (https://en-vi.donghanhcungban.org).
# Đặt khi build cho staging / domain khác. KHÔNG cần dấu "/" ở cuối.
# VITE_SITE_URL=https://en-vi.donghanhcungban.org

# ── apps/hub — trang giới thiệu tổng nền tảng (PR-7) ────────────────────────
# URL app tiếng Anh mà nút "Học ngay"/"Đăng nhập" của hub trỏ tới. Bỏ trống = mặc định
# domain production hiện tại. Build riêng: `npm run build -w hub` (xem apps/hub/vite.config.ts).
# Test song song domain .org (xem docs/doi-ten-mien-chinh-org.md): đặt tạm biến này thành
# https://en-vi.donghanhcungban.org rồi `npm run build && pm2 reload` — CHỈ đổi hướng nút bấm
# của hub, KHÔNG tự động làm đăng nhập Google/Facebook/Apple/Microsoft chạy được trên .org
# (còn phụ thuộc đã thêm domain .org vào từng console OAuth chưa, xem checklist trong docs trên).
# VITE_ENGLISH_APP_URL=https://en-vi.donghanhcungban.org

# ── server.ts: host nào phục vụ app tiếng Anh (còn lại phục vụ hub) — PR-7 ──────
# Bỏ trống = mặc định 'en-vi.donghanhcungban.org' (giữ nguyên hành vi hiện tại trên
# production). Chỉ cần đổi nếu domain app tiếng Anh khác mặc định (staging, domain test).
# Nhận NHIỀU host, phân cách dấu phẩy — dùng khi test song song .com và .org (xem
# docs/doi-ten-mien-chinh-org.md), KHÔNG cần dấu cách quanh dấu phẩy hay bắt buộc:
# EN_VI_HOSTNAME=en-vi.donghanhcungban.com,en-vi.donghanhcungban.org

# ── PostgreSQL TỰ HOST trên VPS — CSDL duy nhất của app (rời Supabase hoàn toàn,
# xem docs/migration-thoat-ly-supabase.md + docs/setup-postgresql-vps.md) ─────────
# Kết nối nội bộ localhost trên VPS nên KHÔNG cần TLS.
# Chạy `npm run migrate:pg` để áp postgres/schema.sql lên DB này.
DATABASE_URL=postgresql://tutor_app:MAT_KHAU_DAT_LUC_TAO@localhost:5432/english_tutor

# Số kết nối tối đa trong pool `pg` (api/_lib/pgPool.ts) — không bắt buộc, mặc định 10 nếu bỏ
# trống. Tăng lên khi tách Postgres ra VPS riêng + PgBouncer (GĐ2 kế hoạch scale, xem
# docs/research/dac-ta-gd2-scale-50k.md + postgres/pgbouncer.ini.example).
# PG_POOL_MAX=20

# Read-replica Postgres (chuẩn bị scale 100k-1M, xem api/_lib/pgPool.ts getPgReadPool()) —
# không bắt buộc, không set thì mọi truy vấn đọc dùng chung DATABASE_URL như hiện tại.
# CHỈ đọc dữ liệu KHÔNG cần mới nhất tuyệt đối (bảng xếp hạng...) mới nên route qua đây.
# DATABASE_URL_READ=postgresql://tutor_app_ro:MAT_KHAU@<ip-replica>:5432/english_tutor
# PG_POOL_READ_MAX=20

# Dùng khi DATABASE_URL trỏ qua PgBouncer (cổng 6432, transaction pooling) — migration/DDL
# (npm run migrate:pg) nên nối THẲNG Postgres (cổng 5432), không qua pooler. Không set thì
# migration dùng chung DATABASE_URL như cũ (đúng khi CHƯA tách PgBouncer).
# MIGRATE_DATABASE_URL=postgresql://tutor_app:MAT_KHAU@<ip-vps-db>:5432/english_tutor

# Giới hạn số lượt gọi ĐANG BAY đồng thời tới từng nhà cung cấp AI/STT/TTS (chuẩn bị scale
# 100k-1M, xem api/_lib/concurrencyLimiter.ts) — KHÔNG bắt buộc, không set = không giới hạn
# (giữ nguyên hành vi hiện tại). Giới hạn tính THEO TỪNG TIẾN TRÌNH (cluster mode N tiến trình
# thì tổng thật = N × số này).
# AI_CONCURRENCY_ANTHROPIC=20
# AI_CONCURRENCY_GROQ=20
# AI_CONCURRENCY_GEMINI=20
# AI_CONCURRENCY_STT=10
# AI_CONCURRENCY_GOOGLE_TTS=20
# AI_CONCURRENCY_GOOGLE_TTS_STUDIO=10
# AI_CONCURRENCY_ELEVENLABS=10

# ── Auth tự viết (Bearer token) ──────────────────────────────────────────────
# Google OAuth Client ID — tạo tại Google Cloud Console → APIs & Services →
# Credentials → Create Credentials → OAuth client ID → Web application. Authorized
# JavaScript origin = domain app (vd https://en-vi.donghanhcungban.com), KHÔNG cần
# redirect URI (dùng Google Identity Services phía client, không redirect server).
# CẢ 2 biến dưới đây PHẢI CÙNG GIÁ TRỊ (1 client ID dùng chung client + server verify).
GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxx.apps.googleusercontent.com

# Facebook Login — tạo app tại developers.facebook.com → My Apps → Create App (loại
# "Consumer") → thêm sản phẩm "Facebook Login" → Settings → Valid OAuth Redirect URIs
# không bắt buộc (dùng SDK phía client, JS SDK domain phải khớp domain app). App ID công
# khai được (VITE_*), App Secret là bí mật, CHỈ đặt ở server.
FACEBOOK_APP_ID=xxxxxxxxxx
FACEBOOK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_FACEBOOK_APP_ID=xxxxxxxxxx

# Sign in with Apple — cần tài khoản Apple Developer Program (trả phí). Tạo tại
# developer.apple.com → Certificates, Identifiers & Profiles → Identifiers → tạo "App ID"
# (bật capability Sign In with Apple) rồi tạo thêm "Services ID" riêng (đây mới là
# APPLE_CLIENT_ID dùng ở đây, KHÔNG phải App ID) → bật Sign In with Apple cho Services ID
# → khai domain + return URL = chính domain app (vd https://en-vi.donghanhcungban.com).
# Chỉ cần verify chữ ký id_token qua JWKS công khai — KHÔNG cần Client Secret/private key
# .p8 (chỉ cần cho luồng đổi authorization code phía server, không dùng ở đây).
APPLE_CLIENT_ID=com.example.app.web
VITE_APPLE_CLIENT_ID=com.example.app.web

# Microsoft đăng nhập (MSAL.js) — tạo App registration tại portal.azure.com → Azure Active
# Directory → App registrations → New registration → chọn "Accounts in any organizational
# directory and personal Microsoft accounts" (multi-tenant + tài khoản cá nhân) → thêm nền
# tảng "Single-page application" với Redirect URI = domain app. Chỉ cần Application (client)
# ID — KHÔNG cần client secret (chỉ dùng luồng public client + verify id_token qua JWKS).
MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
VITE_MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── Cloudflare R2 (audio cache TTS/phát âm) ─────
# Đặt STORAGE_DRIVER=r2 để bật (mặc định vẫn "local" nếu bỏ trống — xem api/_lib/fileStorage.ts).
# 1 tài khoản Cloudflare DUY NHẤT, 1 bucket (xem docs/migration-thoat-ly-supabase.md mục 3.3
# — quyết định KHÔNG sharding nhiều tài khoản để né giới hạn free).
# Lấy R2_ACCOUNT_ID + tạo API token tại Cloudflare Dashboard → R2 → Manage R2 API Tokens.
# BẮT BUỘC bật "Public access" cho bucket (r2.dev subdomain hoặc domain riêng) — audio_url
# trả về cho client phải public-read, xem ghi chú bảo mật đầu file fileStorage.ts.
# STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_BUCKET=english-tutor-audio
# R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ── Cloudflare R2 (BACKUP Postgres) — bucket RIÊNG, để PRIVATE ─────
# Đẩy file backup .sql.gz (do cron pg_dump tạo) lên R2 để backup KHÔNG nằm cùng ổ đĩa với DB
# gốc — ổ hỏng thì mất cả DB lẫn backup. Chạy: npm run backup:r2 (xem scripts/backup-pg-to-r2.ts
# + docs/setup-postgresql-vps.md mục 7.2).
# ⚠️ PHẢI là bucket KHÁC R2_BUCKET ở trên và TUYỆT ĐỐI KHÔNG bật Public access — file backup
# chứa toàn bộ email, mật khẩu đã băm, session token của người dùng. Script tự từ chối chạy nếu
# phát hiện trùng tên với bucket audio (public-read).
# R2_BACKUP_BUCKET=english-tutor-pg-backups
# BACKUP_DIR=/var/backups          # thư mục chứa .sql.gz (mặc định /var/backups)
# BACKUP_KEEP_DAYS=30              # giữ backup trên R2 bao nhiêu ngày (0 = không tự xoá)

# ── Backup file .env (mã hoá) lên R2 — dùng chung R2_BACKUP_BUCKET ở trên ──────
# pg_dump KHÔNG backup .env (API key, secret). Chạy: npm run backup:env (xem
# scripts/backup-env-to-r2.ts + docs/setup-postgresql-vps.md mục 7.3).
# ⚠️ ENV_BACKUP_PASSPHRASE TUYỆT ĐỐI KHÔNG đặt trong .env này — nếu mất .env thì passphrase
# cũng mất theo, backup mã hoá sẽ không giải mã lại được. Chỉ truyền qua biến môi trường lúc
# chạy lệnh (dòng cron), lưu passphrase ở nơi khác (password manager).
# ENV_BACKUP_PASSPHRASE=... (KHÔNG đặt ở đây — xem cảnh báo trên)

# ── Backup cấu hình hệ thống (Nginx + crontab + PM2 dump) lên R2 — dùng chung
# R2_BACKUP_BUCKET + ENV_BACKUP_PASSPHRASE ở trên ──────────────────────────────
# Chạy: npm run backup:system (xem scripts/backup-system-to-r2.ts +
# docs/setup-postgresql-vps.md mục 7.4). Tuỳ chỉnh (không bắt buộc):
# NGINX_CONFIG_DIR=/etc/nginx
# CRONTAB_USERS=root,postgres
# PM2_DUMP_PATH=/root/.pm2/dump.pm2

# CHỈ cần khi KHÔI PHỤC thật (npm run restore:r2 -- --restore-into ...) — connection string tới
# Postgres SUPERUSER trên máy ĐÍCH (KHÔNG phải DATABASE_URL của app — lệnh này cần quyền
# DROP/CREATE DATABASE). Xem docs/ke-hoach-khoi-phuc-su-co.md.
# RESTORE_PSQL_URL=postgresql://postgres:MAT_KHAU_SUPERUSER@localhost:5432/postgres

# ── Google TTS (đọc câu ví dụ + cache phát âm từ điển) ──────────────────────
# Lấy ở Google Cloud Console → APIs & Services → Credentials (sau khi bật Text-to-Speech API)
GOOGLE_TTS_API_KEY=AIza...

# (Tùy chọn) NHIỀU key xoay vòng — mỗi key thuộc 1 project Google Cloud riêng sẽ có
# hạn mức (quota) riêng, gộp nhiều key giúp tránh hết quota giữa chừng. Cách nhau
# dấu phẩy. Có thể dùng CHỈ biến này, hoặc kết hợp với GOOGLE_TTS_API_KEY ở trên
# (key đó cũng tự được gộp vào, không cần lặp lại). Không đặt = chỉ dùng 1 key như cũ.
# GOOGLE_TTS_API_KEYS=AIza...key1,AIza...key2,AIza...key3

# ── ElevenLabs TTS (giọng đặc biệt, CHỈ mở cho gói VIP) ──────────────────────
# (Tùy chọn) Chưa điền → giọng ElevenLabs sẽ lỗi khi chọn, client tự fallback Web Speech,
# 14 giọng Google Chirp3-HD vẫn hoạt động bình thường. Lấy key tại: elevenlabs.io → Profile.
# ELEVENLABS_API_KEY=sk_...

# ── Admin (trang /admin-settings — chỉnh hạn mức lượt dùng + khuyến mãi) ─────
# Danh sách email được coi là admin, cách nhau dấu phẩy (khớp email đăng nhập trong app).
ADMIN_EMAILS=donghanhcungban.org@gmail.com

# ── Đơn giá ước tính chi phí AI (tab "Sử dụng & chi phí" trong /admin) ──────
# Dùng để quy đổi "số lượt dùng" thành tiền, giúp quyết định chỉnh hạn mức/giá gói.
# ĐÂY LÀ ƯỚC TÍNH, không phải hoá đơn thật — ta không đo token từng request.
# Bỏ trống = dùng mặc định trong api/_lib/aiCost.ts (đã ghi rõ cơ sở ước tính ở đó).
# Khi có hoá đơn thật từ nhà cung cấp, chia (tiền tháng ÷ số lượt tháng) rồi điền vào đây.
# AI_COST_CHAT_USD=0.0025
# AI_COST_WRITING_USD=0.004
# AI_COST_SPEAKING_USD=0.003
# AI_COST_STT_USD=0.0005
# AI_COST_PRONOUNCE_USD=0.0004
# Tỉ giá quy đổi USD → VND để so với doanh thu (đơn thanh toán ghi bằng VND).
# USD_VND_RATE=26000

# ── STT (nhận diện giọng nói — chế độ Luyện nói, api/stt.ts) ────────────────
# Hỗ trợ CẢ Groq lẫn OpenAI. Chỉ cần điền MỘT trong hai key bên dưới.
# Có GROQ_API_KEY → ưu tiên dùng Groq (Whisper large v3 turbo, nhanh & rẻ).
# Không có thì dùng OPENAI_API_KEY (model gpt-4o-mini-transcribe).
# KHÔNG có tiền tố VITE_ — chỉ server đọc.

# Groq — lấy key tại: https://console.groq.com/keys (khuyên dùng: rẻ + nhanh)
GROQ_API_KEY=gsk_...

# OpenAI — lấy key tại: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# (Tùy chọn) ép model phiên âm cho nhà cung cấp đang dùng.
# Groq: whisper-large-v3-turbo (mặc định) | whisper-large-v3
# OpenAI: gpt-4o-mini-transcribe (mặc định) | whisper-1
# STT_MODEL=whisper-large-v3-turbo

# ── Azure AI Speech — chấm phát âm chi tiết từng âm vị (① Giai đoạn 2, api/pronounce-assess.ts) ─
# TÙY CHỌN — thiếu 2 biến này thì endpoint tự trả lỗi "chưa cấu hình" (client rơi về Giai đoạn 1
# miễn phí ở trình duyệt, xem src/lib/pronounceCoach.ts), KHÔNG làm vỡ app.
# Lấy key tại Azure Portal → tạo resource "Speech service" → Keys and Endpoint.
# Free tier F0: 5 giờ audio/tháng (đủ ~3.600 câu ngắn — xem giới hạn LIMITS.pronounce trong
# api/_lib/usage.ts, 10 câu/ngày/người dùng free).
# AZURE_SPEECH_KEY=...
# Vùng resource, vd "eastus" (KHÔNG phải region ID dạng "East US") — xem trang resource Azure.
# AZURE_SPEECH_REGION=eastus

# ── Mã hóa AES-256-GCM cho audio TTS cache (api/tts.ts) — xem AUTH_SETUP.md ─
# Khóa gốc 32 byte (base64), CHỈ dùng ở server. Tạo bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TTS_ENCRYPTION_MASTER_KEY=...

# ── Bảo mật API (NÊN đặt khi production) — xem api/_lib/security.ts ──────────
# Danh sách domain được phép gọi API, phân tách bằng dấu phẩy. Bỏ trống = cho phép tất cả
# (chỉ nên bỏ trống lúc dev cục bộ; production nên điền tên miền thật).
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Lưu trữ file audio ──────────────────────────────────────────────────────
# local (mặc định, kể cả bỏ trống) = lưu trên ổ cứng VPS → thư mục uploads/
# r2 = Cloudflare R2 (xem mục Cloudflare R2 ở trên)
STORAGE_DRIVER=local
# Thư mục lưu file (mặc định: <project>/uploads)
# UPLOADS_DIR=/root/bilingual-english-vietnamese/uploads

# Cổng Express lắng nghe (Nginx reverse proxy trỏ vào cổng này)
PORT=3000

# ── Web Push Notification (nhắc học hàng ngày) ──────────────────────────────
# Tạo cặp khóa VAPID (chạy 1 lần): node -e "const wp=require('web-push'); console.log(JSON.stringify(wp.generateVAPIDKeys()))"
# Sau khi tạo: KHÔNG đổi key — đổi key làm mất toàn bộ subscription cũ.
VAPID_PUBLIC_KEY=BP9nog6CutVAu3TM4KyU87JCZMydVmAgAu-tzPUWMd2uztQ1sfkPvoenQ6m6xMxKJ4cQUeAUPLUfHXjvR5Xog10
VAPID_PRIVATE_KEY=REPLACE_WITH_YOUR_PRIVATE_KEY
VAPID_EMAIL=mailto:your@email.com

# Khóa bí mật để gọi endpoint /api/push (action=send-daily) từ cron job VPS
# Tạo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=REPLACE_WITH_RANDOM_HEX

# ── Cài đặt cron nhắc học (trên VPS sau khi deploy) ─────────────────────────
# Thêm vào crontab (crontab -e) để gửi push notification lúc 7h sáng mỗi ngày:
# 0 7 * * * curl -s -X POST https://en-vi.donghanhcungban.com/api/push -H "Content-Type: application/json" -d '{"action":"send-daily","secret":"<CRON_SECRET>"}' >> /var/log/push-cron.log 2>&1

# ── Sentry (observability — bắt lỗi thật khi chạy production) ───────────────
# Tùy chọn — bỏ trống cả 2 biến dưới thì Sentry KHÔNG bật (no-op), app chạy như cũ.
# Lấy DSN: tạo project (chọn platform "React" cho client, "Node.js/Express" cho server)
# miễn phí tại https://sentry.io → Settings → Projects → <project> → Client Keys (DSN).
# Có thể dùng CHUNG 1 DSN cho cả 2 (Sentry vẫn phân biệt được nhờ tag "environment"/runtime),
# hoặc tạo 2 project riêng để tách lỗi client/server cho dễ theo dõi.

# Server (api/_lib/sentry.ts, đọc trong server.ts) — KHÔNG có tiền tố VITE_, không lộ ra bundle.
# SENTRY_DSN=https://xxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX

# Client (src/lib/errorTracking.ts, đọc trong main.tsx) — có tiền tố VITE_ nên sẽ nằm trong
# bundle JS gửi cho browser. DSN không phải bí mật (chỉ dùng để GỬI lỗi lên, không đọc được gì),
# an toàn khi lộ ra client.
# VITE_SENTRY_DSN=https://xxxxx@oXXXXXX.ingest.sentry.io/XXXXXXX

# ── Redis (rate limit toàn cụm) — api/_lib/security.ts ───────────────────────
# KHÔNG BẮT BUỘC. Bỏ trống = rate limit đếm bằng Map trong bộ nhớ của từng tiến trình
# (đúng như trước đây, đủ cho dev local và khi chạy 1 instance).
# Khi chạy PM2 cluster nhiều instance (hoặc nhiều máy), PHẢI đặt REDIS_URL — nếu không,
# mỗi instance đếm riêng nên 1 IP có thể vượt giới hạn gấp N lần (N = số instance).
# Redis lỗi/không kết nối được thì app TỰ ĐỘNG quay về Map in-memory (fail-open), không
# request nào bị vỡ — chỉ ghi 1 dòng cảnh báo trong log.
# REDIS_URL=redis://127.0.0.1:6379

# ── Gửi email (xác thực email chống tài khoản giả) ──────────────────────────
# Dùng SMTP chuẩn nên chạy với BẤT KỲ nhà cung cấp nào: Gmail, Zoho, Resend,
# SendGrid, Amazon SES... Chưa điền thì tính năng gửi mã TỰ ĐỘNG TẮT (no-op),
# app vẫn chạy bình thường — giống cách Sentry đang làm.
# Gmail: bật 2FA rồi tạo "App password", KHÔNG dùng mật khẩu đăng nhập thường.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Địa chỉ hiện ở mục "From". Bỏ trống thì dùng SMTP_USER.
SMTP_FROM=
# Để trống: tự suy ra (cổng 465 = true, còn lại false). Chỉ đặt khi nhà cung cấp yêu cầu khác.
SMTP_SECURE=

# ── Kênh mail DỰ PHÒNG (Amazon SES) — dùng khi kênh chính chạm trần hạn mức ngày ──
# Không điền cũng chạy được, nhưng chạm trần là NGỪNG gửi mã (người dùng thật cũng
# không nhận được). Xem docs/email-setup.md mục 3.
SMTP_FALLBACK_HOST=
SMTP_FALLBACK_PORT=587
SMTP_FALLBACK_USER=
SMTP_FALLBACK_PASS=
# Trần thư/ngày của kênh CHÍNH, để dưới hạn mức thật một khoảng an toàn.
# Brevo free 300/ngày -> đặt 280. Mặc định 280 nếu không điền.
SMTP_DAILY_LIMIT=280

# ── Thanh toán Pro/VIP qua SePay (xem docs/research/dac-ta-thanh-toan-2026-07-25.md) ──
# SePay theo dõi tài khoản ngân hàng của bạn + bắn webhook khi tiền về — KHÔNG phải cổng
# trung gian, không cần tư cách hộ kinh doanh. Đăng ký tại sepay.vn, liên kết tài khoản
# ngân hàng, tạo webhook trỏ về https://<domain>/api/payment-webhook với chứng thực API Key
# (đặt SEPAY_WEBHOOK_API_KEY trùng giá trị khai trên dashboard SePay) + BẬT lọc theo tiền tố
# mã thanh toán "ENVI" (api/_lib/sepay.ts PAYMENT_CODE_PREFIX) để không nhận webhook cho các
# giao dịch cá nhân khác trong cùng tài khoản.
SEPAY_WEBHOOK_API_KEY=
# Số tài khoản nhận tiền — nên dùng 1 tài khoản RIÊNG cho app để đối chiếu sổ sách dễ.
SEPAY_BANK_ACCOUNT=
# Mã ngân hàng dùng cho URL ảnh QR (vd MBBank, Vietcombank...) — xem danh sách hỗ trợ tại
# https://qr.sepay.vn.
SEPAY_BANK_CODE=
