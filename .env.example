# ── AI hội thoại (chat/viết/nói) — api/claude.ts ────────────────────────────
# Có GROQ_API_KEY → ưu tiên dùng Groq Llama (FREE). Không thì dùng Anthropic Claude
# (chất lượng cao hơn cho dạy tiếng, nhưng cần nạp credit). Chỉ cần MỘT trong hai key.
# Lưu ý: GROQ_API_KEY dùng chung cho cả STT (nhận giọng) lẫn chat.
#
# QUAN TRỌNG: không có tiền tố VITE_ — key chỉ được đọc ở phía server
# (vite.config.ts lúc "npm run dev", api/claude.ts lúc chạy server.ts trên VPS).

# Anthropic — lấy key tại https://console.anthropic.com/ (cần credit)
ANTHROPIC_API_KEY=sk-ant-...
# (Tùy chọn) đổi model chat của Groq, mặc định llama-3.3-70b-versatile
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Dự án deploy bằng VPS (Express server.ts + PM2 + Nginx) — KHÔNG dùng Vercel.
# Khi deploy lên VPS (xem docs/deploy-vps-ubuntu.md): dán toàn bộ các biến
# trong file này vào file `.env` trên VPS (cùng thư mục với server.ts).

# ── Supabase — phía FRONTEND (browser) ─────────────────────────────────────
# Các biến có tiền tố VITE_ được Vite đóng gói vào bundle JS gửi cho browser.
# Anon key được thiết kế để public — chỉ có quyền theo Row Level Security.
# Lấy ở Supabase Dashboard → Project Settings → API

VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...

# ── Supabase — phía SERVER (api/) ───────────────────────────────────────────
# Hướng dẫn tạo từng biến: xem SUPABASE_SYNC_SETUP.md / PRONUNCIATION_CACHE_SETUP.md
# KHÔNG có tiền tố VITE_ — chỉ code chạy ở server (api/*.ts) đọc được.

# Lấy ở Supabase Dashboard → Project Settings → API → Project URL
SUPABASE_URL=https://xxxxx.supabase.co

# Lấy ở Supabase Dashboard → Project Settings → API → service_role key (bí mật!)
# Key này có toàn quyền với database, KHÔNG đưa vào code, KHÔNG commit lên Git.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ── Google TTS (đọc câu ví dụ + cache phát âm từ điển) ──────────────────────
# Lấy ở Google Cloud Console → APIs & Services → Credentials (sau khi bật Text-to-Speech API)
GOOGLE_TTS_API_KEY=AIza...

# ── STT (nhận diện giọng nói — chế độ Luyện nói, api/stt.ts) ────────────────
# Hỗ trợ CẢ Groq lẫn OpenAI. Chỉ cần điền MỘT trong hai key bên dưới.
# Có GROQ_API_KEY → ưu tiên dùng Groq (Whisper large v3 turbo, nhanh & rẻ).
# Không có thì dùng OPENAI_API_KEY (model gpt-4o-mini-transcribe).
# KHÔNG có tiền tố VITE_ — chỉ server đọc.

# Groq — lấy key tại: https://console.groq.com/keys (khuyên dùng: rẻ + nhanh)
GROQ_API_KEY=gsk_...

# OpenAI — lấy key tại: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# (Tùy chọn) ép model phiên âm cho nhà cung cấp đang dùng.
# Groq: whisper-large-v3-turbo (mặc định) | whisper-large-v3
# OpenAI: gpt-4o-mini-transcribe (mặc định) | whisper-1
# STT_MODEL=whisper-large-v3-turbo

# ── Mã hóa AES-256-GCM cho audio TTS cache (api/tts.ts) — xem AUTH_SETUP.md ─
# Khóa gốc 32 byte (base64), CHỈ dùng ở server. Tạo bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TTS_ENCRYPTION_MASTER_KEY=...

# ── Bảo mật API (NÊN đặt khi production) — xem api/_lib/security.ts ──────────
# Danh sách domain được phép gọi API, phân tách bằng dấu phẩy. Bỏ trống = cho phép tất cả
# (chỉ nên bỏ trống lúc dev cục bộ; production nên điền tên miền thật).
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Lưu trữ file audio ──────────────────────────────────────────────────────
# local  = lưu trên ổ cứng VPS (miễn phí, khuyên dùng) → thư mục uploads/
# (bỏ trống / supabase = lưu trên Supabase Storage)
STORAGE_DRIVER=local
# Thư mục lưu file (mặc định: <project>/uploads)
# UPLOADS_DIR=/root/bilingual-english-vietnamese/uploads

# Cổng Express lắng nghe (Nginx reverse proxy trỏ vào cổng này)
PORT=3000
