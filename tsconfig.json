{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    // Alias CHỈ cho src/ (Vite bundle) — xem chú thích trong vite.config.ts. @core/@english
    // tạm thời cùng trỏ vào apps/english/src/*, chỉ là gán nhãn trước khi tách packages/apps thật.
    "baseUrl": ".",
    "paths": {
      "@core/*": ["apps/english/src/*"],
      "@english/*": ["apps/english/src/*"]
    }
  },
  "include": ["apps/english/src"],
  "exclude": [
    "apps/english/src/**/*.test.ts",
    "apps/english/src/**/*.test.tsx",
    "apps/english/src/**/*.spec.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
