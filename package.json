{
  "name": "english-tutor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-data-manifest.mjs && tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx server.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "seed:pronunciation": "tsx scripts/seed-pronunciations.ts",
    "prefetch:tts-patterns": "tsx scripts/prefetch-tts-patterns.ts",
    "seed:all": "tsx scripts/seed-all.ts",
    "remap:tts-cache": "tsx scripts/remap-tts-cache.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "compression": "^1.7.4",
    "express": "^4.21.2",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cli-progress": "^3.11.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "^10.4.19",
    "cli-progress": "^3.12.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "happy-dom": "^20.10.6",
    "postcss": "^8.4.39",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.2",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.22.4",
    "typescript": "^5.2.2",
    "vite": "^7.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-imagemin": "^0.6.1",
    "vitest": "^3.2.6"
