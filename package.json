{
  "name": "english-tutor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/gen-data-manifest.mjs && tsc && tsc -p tsconfig.api.json && vite build",
    "typecheck": "tsc && tsc -p tsconfig.api.json && tsc -p tsconfig.e2e.json",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "size": "size-limit",
    "start": "tsx server.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "seed:pronunciation": "tsx scripts/seed-pronunciations.ts",
    "tag:cefr": "tsx scripts/tag-cefr-levels.ts",
    "tag:freq": "tsx scripts/assign-word-freq.ts",
    "gen:word-forms": "tsx scripts/gen-word-forms.ts",
    "gen:form-examples": "tsx scripts/gen-form-examples.ts",
    "extract:words-cefr": "tsx scripts/extract-words-cefr-subset.ts",
    "prefetch:tts-patterns": "tsx scripts/prefetch-tts-patterns.ts",
    "seed:all": "tsx scripts/seed-all.ts",
    "seed:verify": "tsx scripts/seed-all.ts --verify",
    "sync:storage": "tsx scripts/sync-storage-to-vps.ts",
    "check:supabase": "tsx scripts/check-supabase-audio.ts",
    "migrate": "tsx scripts/run-migrations.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@sentry/node": "^10.63.0",
    "@sentry/react": "^10.63.0",
    "@supabase/supabase-js": "^2.108.2",
    "compression": "^1.7.4",
    "express": "^4.21.2",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@commitlint/cli": "^21.1.0",
    "@commitlint/config-conventional": "^21.1.0",
    "@playwright/test": "^1.61.1",
    "@size-limit/file": "^12.1.0",
    "@types/cli-progress": "^3.11.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/web-push": "^3.6.4",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.19",
    "cli-progress": "^3.12.0",
    "dotenv": "^17.4.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "pg": "^8.22.0",
    "postcss": "^8.4.39",
    "prettier": "^3.9.1",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.2",
    "size-limit": "^12.1.0",
    "subtlex-word-frequencies": "^2.0.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.22.4",
    "typescript": "^5.2.2",
    "vite": "^7.3.5",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^3.2.6"
  }
}
